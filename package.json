{
  "name": "branchback",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-branchback",
    "emulators:full": "firebase emulators:start --only auth,firestore,dataconnect --project demo-branchback",
    "dev:all": "concurrently -k -n next,emulators -c blue,green \"pnpm dev\" \"pnpm emulators\"",
    "dataconnect:generate": "firebase dataconnect:sdk:generate --watch",
    "deploy": "firebase deploy --only hosting,dataconnect"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@xyflow/react": "^12.10.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "firebase": "^12.12.1",
    "firebase-admin": "^13.8.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.11.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.5.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/dagre": "^0.7.54",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "firebase-tools": "^15.15.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
