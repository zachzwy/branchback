# ─────────────────────────────────────────────────────────────────────────────
# Branchback — example environment. Copy to `.env.local`, then edit as needed.
# A bare copy boots the app with Firebase emulators + the mock orchestrator
# (no real Firebase project, no LLM key required).
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase ────────────────────────────────────────────────────────────────

# Use the local Firebase Auth + Firestore emulators. Set to "false" to point
# the app at a real Firebase project (then fill in the NEXT_PUBLIC_FIREBASE_*
# values below with the web SDK config from your Firebase console).
NEXT_PUBLIC_USE_EMULATORS=true

# Emulator endpoints (only used when NEXT_PUBLIC_USE_EMULATORS=true). The
# ports match firebase.json's emulator block; the demo- prefix tells the
# Firebase Admin SDK no real project is needed.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-branchback
NEXT_PUBLIC_AUTH_EMULATOR_URL=http://127.0.0.1:18099
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:18099
FIRESTORE_EMULATOR_HOST=127.0.0.1:18580

# Real Firebase project values (only needed when NEXT_PUBLIC_USE_EMULATORS=false).
# Get these from Firebase console → Project settings → Your apps → Web app config.
# These are NOT secrets — Firebase web SDK config is intentionally client-visible.
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=...
# NEXT_PUBLIC_FIREBASE_APP_ID=...
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=...

# Server-side admin credentials (only needed when NEXT_PUBLIC_USE_EMULATORS=false).
# Pick one. In deployed Google/Firebase infrastructure, leave both unset and
# Application Default Credentials will be used automatically.
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# ── Repository backend ──────────────────────────────────────────────────────

# firestore (default) — firebase-admin/firestore (emulator or real project).
# memory                — in-process map; state evaporates on restart. Tests/CI.
# dataconnect           — Postgres-future skeleton; methods throw not_yet_implemented.
REPOSITORY_MODE=firestore

# ── Orchestrator + Brief Synthesizer ────────────────────────────────────────

# Picks the LLM adapter at runtime.
#   mock     — deterministic two-turn script. No network, no keys. Great for
#              walking the slice the first time.
#   ollama   — local model via the Ollama server (see OLLAMA_* below).
#   openai   — any OpenAI-compatible endpoint (see LLM_* below).
# When unset and LLM_API_KEY is present, defaults to "openai". Otherwise "mock".
ORCHESTRATOR_MODE=mock
BRIEF_SYNTHESIS_MODE=mock

# ── OpenAI-compatible adapter ───────────────────────────────────────────────

# Any provider that speaks the OpenAI Chat Completions protocol works here.
# Set all three (API key, base URL, model) for a real provider.
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# Provider examples — uncomment the trio for the one you want:
#
# OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
#
# DeepSeek:
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
#
# Groq:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-70b-versatile
#
# Together:
# LLM_BASE_URL=https://api.together.xyz/v1
# LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
#
# OpenRouter (routes to OpenAI, Anthropic, Gemini, Mistral, …):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-3.5-sonnet
#
# Fireworks:
# LLM_BASE_URL=https://api.fireworks.ai/inference/v1
# LLM_MODEL=accounts/fireworks/models/llama-v3p1-70b-instruct
#
# Mistral:
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_MODEL=mistral-large-latest
#
# Self-hosted vLLM:
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
#
# LM Studio:
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=local-model

# OpenAI adapter tuning (orchestrator). Defaults shown.
# LLM_TEMPERATURE=0.4
# LLM_MAX_TOKENS=512
# LLM_TIMEOUT_MS=60000

# Brief-specific overrides — fall back to LLM_* above when unset.
# LLM_BRIEF_MODEL=
# LLM_BRIEF_TEMPERATURE=0.5
# LLM_BRIEF_MAX_TOKENS=768

# Opt-in per-user daily rate limit on LLM calls. 0 = disabled (default).
# Useful when self-hosting a public instance to cap API cost per user.
# LLM_RATE_LIMIT_PER_DAY=0
# LLM_RATE_LIMIT_WINDOW_HOURS=24

# ── Ollama adapter ──────────────────────────────────────────────────────────

# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma4:e2b
# OLLAMA_TEMPERATURE=0.4
# OLLAMA_NUM_PREDICT=256
# OLLAMA_NUM_CTX=
# OLLAMA_TIMEOUT_MS=60000

# Brief-specific overrides — fall back to OLLAMA_MODEL / OLLAMA_TEMPERATURE.
# OLLAMA_BRIEF_MODEL=
# OLLAMA_BRIEF_TEMPERATURE=
